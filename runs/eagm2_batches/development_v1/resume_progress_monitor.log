29269 /bin/bash -O extglob -c snap=$(command cat <&3) && builtin shopt -s extglob && builtin eval -- "$snap" && { builtin set +u 2>/dev/null || true; builtin eval "${__CURSOR_SANDBOX_ENV_RESTORE:-}" 2>/dev/null; builtin export PWD="$(builtin pwd)"; builtin shopt -s expand_aliases 2>/dev/null; builtin eval "$1" < /dev/null; }; COMMAND_EXIT_CODE=$?; dump_bash_state >&4; builtin exit $COMMAND_EXIT_CODE -- cd /home/aaa/workspace/EAGM-2.0-full-validation # Wait until continue pipeline leaves "waiting/starting" and reaches terminal or confirmation states; # also keep heartbeating development progress. while true; do   date -Is   cat runs/eagm2_batches/development_v1/experiment_status.csv   if [[ -f reports/eagm2_dev/continue_pipeline_state.json ]]; then     python3 -c "import json; s=json.load(open('reports/eagm2_dev/continue_pipeline_state.json')); print('pipeline', s.get('status'), 'roots', s.get('completed_roots'), 'nogo', s.get('no_go'))"     st=$(python3 -c "import json; print(json.load(open('reports/eagm2_dev/continue_pipeline_state.json')).get('status',''))")     case "$st" in       completed_no_go|confirmation_completed|needs_review|confirmation_failed)         echo "PIPELINE_TERMINAL=$st"         cat reports/eagm2_dev/continue_pipeline_state.json         exit 0         ;;     esac   fi   # if both schedulers dead and not all roots done, exit with failure signal   if ! pgrep -f "resume_authorized_batch.py --batch-dir runs/eagm2_batches/development_v1" >/dev/null \      && ! pgrep -f "continue_after_development.py" >/dev/null; then     echo "SCHEDULERS_DEAD"     cat runs/eagm2_batches/development_v1/experiment_status.csv     cat reports/eagm2_dev/continue_pipeline_state.json 2>/dev/null || true     exit 1   fi   sleep 600 done 
